<mxfile host="Electron">
  <diagram name="Página-1" id="HA2QAO79sSiijc3F7Ase">
    <mxGraphModel dx="2680" dy="2065" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ==========================================\n    %% CAPA VIEW\n    %% ==========================================\n    class VentanaBase {\n        &lt;&lt;abstract&gt;&gt;\n        #String titulo\n        #boolean estaConectado\n        +mostrarError(msj: String) void\n        +cambiarEstadoRed(conectado: boolean) void\n    }\n\n    class MesaVentana {\n        +mostrarMenu() void\n        +enviarPedido() void\n    }\n\n    class ComponenteMesaGUI {\n        -String numeroMesa\n        -String estado\n        +cambiarColorEstado() void\n    }\n\n    class CocinaVentana {\n        +actualizarTablaPedidos() void\n        +onEstadoCambiado(pedido: Pedido) void\n    }\n\n    class LoginVentana {\n        +AdminVentana() void\n    }\n\n    VentanaBase &lt;|-- MesaVentana\n    VentanaBase &lt;|-- CocinaVentana\n    VentanaBase &lt;|-- LoginVentana\n    MesaVentana *-- ComponenteMesaGUI\n\n    %% ==========================================\n    %% CAPA CONTROLLER\n    %% ==========================================\n    class LoginController {\n        -LoginVentana vistaLogin\n        -ClientSocket clienteSocket\n        +validarCredenciales(email: String, pass: String) void\n    }\n\n    class CocinaController {\n        -CocinaVentana vistaCocina\n        +marcarComoListo(idPedido: int) void\n        +cargarPedidosPendientes() List~Pedido~\n    }\n\n    class PedidoController {\n        -ClientSocket clienteSocket\n        -MesaVentana vista\n        +enviarPedido(pedido: Pedido) boolean\n        +procesarNuevoPedido(pedido: Pedido) void\n    }\n\n    %% ==========================================\n    %% CAPA NETWORK\n    %% ==========================================\n    class Server {\n        -int puerto\n        +boolean enEjecucion\n        +aceptarConexion() void\n    }\n\n    class ClientHandler {\n        +Socket socket\n        +ObjectOutputStream out\n        +ObjectInputStream in\n        +run() void\n        +procesarPeticion(msg: String) void\n        +cerrarConexiones() void\n    }\n\n    class ClientSocket {\n        +String host\n        +int puerto\n        +Socket socket\n        +ObjectOutputStream out\n        +ObjectInputStream in\n        +conectar() void\n        +enviarPeticion(peticion: MensajeRed) MensajeRed\n        +desconectar() void\n    }\n\n    class MensajeRed {\n        -String tipoOperacion\n        -Object contenido\n        -String origen\n        -LocalDateTime timestamp\n        +getTipoOperacion() String\n        +getContenido() Object\n    }\n\n    Server o-- ClientHandler\n    ClientHandler ..&gt; MensajeRed : &lt;&lt;use&gt;&gt;\n    ClientSocket ..&gt; MensajeRed : &lt;&lt;use&gt;&gt;\n\n    %% ==========================================\n    %% CAPA SERVICES &amp; CONCURRENCY\n    %% ==========================================\n    class PedidoService {\n        +crearPedido(pedido: Pedido) Pedido\n        +insertar(pedido: Pedido) boolean\n        +obtenerPorId(idPedido: int) Pedido\n        +actualizarEstado(idPedido: int, idEstado: int) boolean\n        +listarPedidosActivos() List~Pedido~\n        +cancelarPedido(idPedido: int) boolean\n        +aplicarDescuentoAPedido(idPedido: int, codigoDescuento: String) boolean\n    }\n\n    class UsuarioService {\n        +autenticar(email: String, pass: String) Usuario\n        +obtenerPorId(id: int) Usuario\n    }\n\n    class AuditoriaService {\n        +registrarEvento(idUsuario: String, accion: String, detalle: String) void\n        +registrarError(origen: String, ex: Exception) void\n    }\n\n    class ObserverService {\n        +onEstadoCambiado(pedido: Pedido) void\n    }\n\n    class GestorPedidosConcurrente {\n        -BlockingQueue~Pedido~ colaPedidos\n        -ExecutorService poolCocina\n        -boolean enEjecucion\n        +agregarPedido(pedido: Pedido) void\n        +iniciarProcesamiento() void\n        +detener() void\n    }\n\n    class ProcesadorPedidoTask {\n        -Pedido pedido\n        +run() void\n    }\n\n    class MonitorMesaSincronizado {\n        -Mesa mesa\n        -ReentrantLock lock\n        +actualizarEstadoMesa(nuevoEstado: String) void\n        +getMesa() Mesa\n    }\n\n    GestorPedidosConcurrente o-- ProcesadorPedidoTask\n    ProcesadorPedidoTask ..&gt; PedidoService : &lt;&lt;use&gt;&gt;\n    MonitorMesaSincronizado ..&gt; Mesa : &lt;&lt;use&gt;&gt;\n\n    CocinaController ..&gt; PedidoService : &lt;&lt;use&gt;&gt;\n    PedidoController ..&gt; PedidoService : &lt;&lt;use&gt;&gt;\n    LoginController ..&gt; UsuarioService : &lt;&lt;use&gt;&gt;\n\n    %% ==========================================\n    %% CAPA MODEL\n    %% ==========================================\n    class Usuario {\n        &lt;&lt;abstract&gt;&gt;\n        #int idUsuario\n        #String nombre\n        #String email\n        #String password\n        #Rol rol\n        +autenticar() boolean\n        +getRol() Rol\n    }\n\n    class Rol {\n        -int idRol\n        -String nombreRol\n    }\n\n    class PersonalCocina {\n        -int idEstacion\n        +cambiarEstadoPedido() void\n    }\n\n    class PersonalAtencion {\n        -String turno\n        +tomarPedido() void\n        +liberarMesa() void\n    }\n\n    class Administrador {\n        +gestionarUsuarios() void\n        +gestionarMenu() void\n    }\n\n    class SesionUsuario {\n        -Usuario usuarioActivo\n        -SesionUsuario()\n        +getInstancia() SesionUsuario\n        +setUsuarioActivo(u: Usuario) void\n    }\n\n    class EstacionPreparacion {\n        -String nombreEstacion\n        -int idEstacion\n    }\n\n    class Pedido {\n        -int idPedido\n        -EstadoPedido estado\n        -Mesa mesa\n        -double total\n        -LocalDateTime fechaHora\n        -String tipoPedido\n        -Descuento descuento\n        +agregarDetalle(detalle: DetallePedido) void\n        +eliminarDetalle(idDetalle: int) void\n        +calcularTotal() double\n        +cambiarEstado(nuevoEstado: EstadoPedido) void\n    }\n\n    class DetallePedido {\n        -int idDetalle\n        -int cantidad\n        -double precioUnitario\n        -String observaciones\n        +Subtotal() double\n    }\n\n    class Producto {\n        -int idProducto\n        -Categoria categoria\n        -String nombre\n        -boolean disponible\n        -double precio\n    }\n\n    class Categoria {\n        -int idCategoria\n        -String nombreCategoria\n    }\n\n    class Mesa {\n        -int idMesa\n        -String numeroMesa\n        -int capacidad\n        -String estado\n        -boolean disponible\n    }\n\n    class EstadoPedido {\n        -int idEstado\n        -String nombreEstado\n    }\n\n    class Pago {\n        -int idPago\n        -String estadoPago\n        -String metodoPago\n        -double monto\n        -Pedido pedido\n    }\n\n    class Descuento {\n        -int idDescuento\n        -String codigo\n        -double porcentaje\n        -boolean activo\n    }\n\n    Usuario &lt;|-- PersonalCocina\n    Usuario &lt;|-- PersonalAtencion\n    Usuario &lt;|-- Administrador\n    Usuario \&quot;1\&quot; --&gt; \&quot;1\&quot; Rol\n    SesionUsuario \&quot;1\&quot; --&gt; \&quot;1\&quot; Usuario\n\n    Pedido \&quot;1\&quot; *-- \&quot;1..*\&quot; DetallePedido : composición\n    DetallePedido \&quot;*\&quot; --&gt; \&quot;1\&quot; Producto\n    Producto \&quot;*\&quot; --&gt; \&quot;1\&quot; Categoria\n    Pedido \&quot;*\&quot; --&gt; \&quot;1\&quot; Mesa\n    Pedido \&quot;*\&quot; --&gt; \&quot;1\&quot; EstadoPedido\n    Pedido \&quot;*\&quot; --&gt; \&quot;0..1\&quot; Descuento\n    Pago \&quot;1\&quot; --&gt; \&quot;1\&quot; Pedido\n    PersonalCocina \&quot;1\&quot; --&gt; \&quot;1\&quot; EstacionPreparacion\n\n    %% ==========================================\n    %% CAPA DAO\n    %% ==========================================\n    class ConexionBD {\n        -ConexionBD instancia\n        -String user\n        -String pass\n        +getConexion() Connection\n        +cerrarConexion() void\n    }\n\n    class PedidoDAO {\n        -Connection conexion\n        +insertar(pedido: Pedido) int\n        +obtenerPorId(idPedido: int) Pedido\n        +actualizarEstado(idPedido: int, estado: EstadoPedido) boolean\n        +listarTodos() List~Pedido~\n        +listarPorEstado(estado: EstadoPedido) List~Pedido~\n        +eliminar(idPedido: int) boolean\n    }\n\n    class ProductoDAO {\n        +crear(producto: Producto) boolean\n        +actualizar(producto: Producto) boolean\n        +eliminar(idProducto: int) boolean\n        +obtenerPorId(idProducto: int) Producto\n        +listarTodos() List~Producto~\n    }\n\n    class MesaDAO {\n        +actualizarEstado(idMesa: int, estado: String) boolean\n        +obtenerPorId(idMesa: int) Mesa\n        +listarTodas() List~Mesa~\n        +asignarMesa(numMesa: int) void\n    }\n\n    class PagoDAO {\n        +registrarPago(pago: Pago) boolean\n        +obtenerPorPedido(idPedido: int) Pago\n    }\n\n    class AuditoriaDAO {\n        -String logFolderPath\n        -String connectionString\n        +registrarEvento(idUsuario: String, accion: String, detalle: String) void\n        +registrarError(origen: String, ex: Exception) void\n    }\n\n    class DescuentoDAO {\n        +obtenerPorCodigo(codigo: String) Descuento\n        +validarDescuento(codigo: String) boolean\n        +crearDescuento(descuento: Descuento) int\n    }\n\n    PedidoService ..&gt; PedidoDAO : &lt;&lt;use&gt;&gt;\n    UsuarioService ..&gt; Usuario : &lt;&lt;use&gt;&gt;\n    AuditoriaService ..&gt; AuditoriaDAO : &lt;&lt;use&gt;&gt;\n\n    PedidoDAO ..&gt; ConexionBD : &lt;&lt;use&gt;&gt;\n    ProductoDAO ..&gt; ConexionBD : &lt;&lt;use&gt;&gt;\n    MesaDAO ..&gt; ConexionBD : &lt;&lt;use&gt;&gt;\n    PagoDAO ..&gt; ConexionBD : &lt;&lt;use&gt;&gt;\n    AuditoriaDAO ..&gt; ConexionBD : &lt;&lt;use&gt;&gt;\n    DescuentoDAO ..&gt; ConexionBD : &lt;&lt;use&gt;&gt;\n\n    PedidoDAO ..&gt; Pedido : &lt;&lt;use&gt;&gt;\n    ProductoDAO ..&gt; Producto : &lt;&lt;use&gt;&gt;\n    MesaDAO ..&gt; Mesa : &lt;&lt;use&gt;&gt;\n    PagoDAO ..&gt; Pago : &lt;&lt;use&gt;&gt;\n    DescuentoDAO ..&gt; Descuento : &lt;&lt;use&gt;&gt;\n\n    %% ==========================================\n    %% CAPA EXCEPTIONS\n    %% ==========================================\n    class SmartOrderException {\n        -int codigoError\n        -LocalDateTime timestamp\n        +getCodigoError() int\n        +getTimestamp() LocalDateTime\n    }\n\n    class ConexionServidorException {\n        -String host\n        -int puerto\n        +getHost() String\n        +getPuerto() int\n    }\n\n    class MensajeProtocoloInvalidException {\n        -String mensajeRecibido\n        +getMensajeRecibido() String\n    }\n\n    class CapacidadServidorExcedidaException {\n        -int conexionesActuales\n        -int maxPermitidas\n        +getConexionesActuales() int\n    }\n\n    class PedidoNotFoundException {\n        -int idPedidoBuscado\n        +getIdPedidoBuscado() int\n    }\n\n    class EstadoPedidoInvalidoException {\n        -String estadoActual\n        -String estadoIntentado\n        +getEstadoActual() String\n    }\n\n    class MesaNoDisponibleException {\n        -int idMesa\n        -String estadoMesa\n        +getIdMesa() int\n    }\n\n    class ProductoNoDisponibleException {\n        -int idProducto\n        +getIdProducto() int\n    }\n\n    class PrecioInvalidoException {\n        -double precioIngresado\n        +getPrecioIngresado() double\n    }\n\n    SmartOrderException &lt;|-- ConexionServidorException\n    SmartOrderException &lt;|-- MensajeProtocoloInvalidException\n    SmartOrderException &lt;|-- CapacidadServidorExcedidaException\n    SmartOrderException &lt;|-- PedidoNotFoundException\n    SmartOrderException &lt;|-- EstadoPedidoInvalidoException\n    SmartOrderException &lt;|-- MesaNoDisponibleException\n    SmartOrderException &lt;|-- ProductoNoDisponibleException\n    SmartOrderException &lt;|-- PrecioInvalidoException\n\n    %% ==========================================\n    %% ESTILOS Y COLORES POR CAPA\n    %% ==========================================\n    %% VIEW (Naranja)\n    style VentanaBase fill:#ffe6cc,stroke:#d79b00,stroke-width:2px,color:#000\n    style MesaVentana fill:#ffe6cc,stroke:#d79b00,stroke-width:1px,color:#000\n    style ComponenteMesaGUI fill:#ffe6cc,stroke:#d79b00,stroke-width:1px,color:#000\n    style CocinaVentana fill:#ffe6cc,stroke:#d79b00,stroke-width:1px,color:#000\n    style LoginVentana fill:#ffe6cc,stroke:#d79b00,stroke-width:1px,color:#000\n\n    %% CONTROLLER (Gris/Violeta)\n    style LoginController fill:#f5f5f5,stroke:#6c757d,stroke-width:1px,color:#000\n    style CocinaController fill:#f5f5f5,stroke:#6c757d,stroke-width:1px,color:#000\n    style PedidoController fill:#f5f5f5,stroke:#6c757d,stroke-width:1px,color:#000\n\n    %% NETWORK (Rosa / Coral Red)\n    style Server fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style ClientHandler fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style ClientSocket fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style MensajeRed fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n\n    %% SERVICES &amp; CONCURRENCY (Verde y Púrpura)\n    style PedidoService fill:#d5e8d4,stroke:#82b366,stroke-width:1px,color:#000\n    style UsuarioService fill:#d5e8d4,stroke:#82b366,stroke-width:1px,color:#000\n    style AuditoriaService fill:#d5e8d4,stroke:#82b366,stroke-width:1px,color:#000\n    style ObserverService fill:#d5e8d4,stroke:#82b366,stroke-width:1px,color:#000\n    style GestorPedidosConcurrente fill:#e1d5e7,stroke:#9673a6,stroke-width:1px,color:#000\n    style ProcesadorPedidoTask fill:#e1d5e7,stroke:#9673a6,stroke-width:1px,color:#000\n    style MonitorMesaSincronizado fill:#e1d5e7,stroke:#9673a6,stroke-width:1px,color:#000\n\n    %% MODEL (Azul Pastel)\n    style Usuario fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style Rol fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style PersonalCocina fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style PersonalAtencion fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style Administrador fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style SesionUsuario fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style EstacionPreparacion fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style Pedido fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#000\n    style DetallePedido fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style Producto fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style Categoria fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style Mesa fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style EstadoPedido fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style Pago fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n    style Descuento fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px,color:#000\n\n    %% DAO (Turquesa / Cian)\n    style ConexionBD fill:#e0f7fa,stroke:#00acc1,stroke-width:1px,color:#000\n    style PedidoDAO fill:#e0f7fa,stroke:#00acc1,stroke-width:1px,color:#000\n    style ProductoDAO fill:#e0f7fa,stroke:#00acc1,stroke-width:1px,color:#000\n    style MesaDAO fill:#e0f7fa,stroke:#00acc1,stroke-width:1px,color:#000\n    style PagoDAO fill:#e0f7fa,stroke:#00acc1,stroke-width:1px,color:#000\n    style AuditoriaDAO fill:#e0f7fa,stroke:#00acc1,stroke-width:1px,color:#000\n    style DescuentoDAO fill:#e0f7fa,stroke:#00acc1,stroke-width:1px,color:#000\n\n    %% EXCEPTIONS (Rojo Suave / Coral)\n    style SmartOrderException fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#000\n    style ConexionServidorException fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style MensajeProtocoloInvalidException fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style CapacidadServidorExcedidaException fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style PedidoNotFoundException fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style EstadoPedidoInvalidoException fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style MesaNoDisponibleException fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style ProductoNoDisponibleException fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000\n    style PrecioInvalidoException fill:#f8cecc,stroke:#b85450,stroke-width:1px,color:#000&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4vfqehpfDPf6awB1FPNI-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
