<mxfile host="Electron">
  <diagram name="Página-1" id="MU1MKrrsDlD9gioNRe6O">
    <mxGraphModel dx="766" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ==========================================\n    %% ENTIDADES Y RELACIONES\n    %% ==========================================\n    \n    ROLES ||--o{ USUARIOS : \&quot;asigna\&quot;\n    USUARIOS ||--o{ SESIONES_USUARIO : \&quot;inicia\&quot;\n    USUARIOS }o--|| ESTACIONES_PREPARACION : \&quot;asignado_a\&quot;\n    \n    MESAS ||--o{ PEDIDOS : \&quot;registra\&quot;\n    ESTADOS_PEDIDO ||--o{ PEDIDOS : \&quot;clasifica\&quot;\n    DESCUENTOS |o--o{ PEDIDOS : \&quot;aplica\&quot;\n    \n    PEDIDOS ||--|{ DETALLES_PEDIDO : \&quot;contiene\&quot;\n    PRODUCTOS ||--o{ DETALLES_PEDIDO : \&quot;incluido_en\&quot;\n    CATEGORIAS ||--o{ PRODUCTOS : \&quot;pertence_a\&quot;\n    \n    PEDIDOS ||--o| PAGOS : \&quot;genera\&quot;\n    USUARIOS ||--o{ AUDITORIA_LOGS : \&quot;genera_evento\&quot;\n\n    %% ==========================================\n    %% DEFINICIÓN DE TABLAS\n    %% ==========================================\n\n    ROLES {\n        int id_rol PK\n        string nombre_rol\n    }\n\n    USUARIOS {\n        int id_usuario PK\n        int id_rol FK\n        int id_estacion FK\n        string nombre\n        string email\n        string password\n    }\n\n    SESIONES_USUARIO {\n        int id_sesion PK\n        int id_usuario FK\n        datetime fecha_inicio\n        boolean activa\n    }\n\n    ESTACIONES_PREPARACION {\n        int id_estacion PK\n        string nombre_estacion\n    }\n\n    MESAS {\n        int id_mesa PK\n        string numero_mesa\n        int capacidad\n        string estado\n        boolean disponible\n    }\n\n    ESTADOS_PEDIDO {\n        int id_estado PK\n        string nombre_estado\n    }\n\n    DESCUENTOS {\n        int id_descuento PK\n        string codigo\n        decimal porcentaje\n        boolean activo\n    }\n\n    CATEGORIAS {\n        int id_categoria PK\n        string nombre_categoria\n    }\n\n    PRODUCTOS {\n        int id_producto PK\n        int id_categoria FK\n        string nombre\n        decimal precio\n        boolean disponible\n    }\n\n    PEDIDOS {\n        int id_pedido PK\n        int id_mesa FK\n        int id_estado FK\n        int id_descuento FK\n        decimal total\n        datetime fecha_hora\n        string tipo_pedido\n    }\n\n    DETALLES_PEDIDO {\n        int id_detalle PK\n        int id_pedido FK\n        int id_producto FK\n        int cantidad\n        decimal precio_unitario\n        string observaciones\n    }\n\n    PAGOS {\n        int id_pago PK\n        int id_pedido FK\n        string estado_pago\n        string metodo_pago\n        decimal monto\n    }\n\n    AUDITORIA_LOGS {\n        int id_log PK\n        int id_usuario FK\n        string accion\n        string detalle\n        datetime timestamp\n    }\n\n    %% ==========================================\n    %% ESTILOS Y COLORES POR CATEGORÍA\n    %% ==========================================\n\n    %% Entidades Transaccionales / Clave (Azul)\n    style PEDIDOS fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px\n    style DETALLES_PEDIDO fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px\n    style PAGOS fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px\n\n    %% Usuarios y Control de Acceso (Gris / Violeta)\n    style USUARIOS fill:#f5f5f5,stroke:#6c757d,stroke-width:1px\n    style ROLES fill:#f5f5f5,stroke:#6c757d,stroke-width:1px\n    style SESIONES_USUARIO fill:#f5f5f5,stroke:#6c757d,stroke-width:1px\n\n    %% Catálogos del Menú y Operación (Verde)\n    style PRODUCTOS fill:#d5e8d4,stroke:#82b366,stroke-width:1px\n    style CATEGORIAS fill:#d5e8d4,stroke:#82b366,stroke-width:1px\n    style ESTACIONES_PREPARACION fill:#d5e8d4,stroke:#82b366,stroke-width:1px\n\n    %% Entidades de Estado, Reglas y Mesas (Naranja)\n    style MESAS fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style ESTADOS_PEDIDO fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n    style DESCUENTOS fill:#ffe6cc,stroke:#d79b00,stroke-width:1px\n\n    %% Auditoría y Logs (Turquesa / Cian)\n    style AUDITORIA_LOGS fill:#e0f7fa,stroke:#00acc1,stroke-width:1px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9lLLxoNmfUNZwKLeTdzX-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
